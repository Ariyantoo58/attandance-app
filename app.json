{
  "expo": {
    "name": "hr",
    "slug": "hr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/secretary.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/secretary.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.antigravity.hr"
    },
    "android": {
      "package": "com.antigravity.hr",
      "statusBar": {
        "translucent": true,
        "backgroundColor": "#00000000"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/secretary.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/secretary.png"
    },
    "plugins": [
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan aplikasi mengakses kamera untuk fitur pengenalan wajah.",
          "microphonePermission": "Izinkan aplikasi mengakses mikrofon."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Izinkan aplikasi mengetahui lokasi Anda untuk validasi presensi."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "46c39119-de6c-4128-b237-d5f52ef3aa95"
      }
    }
  }
}
